{
  "name": "alissta-sum",
  "version": "1.0.0",
  "author": "ADA S.A. Fábrica de Software Medellín",
  "private": true,
  "scripts": {
    "generate": "ionic generate",
    "start": "ionic serve --port=8100",
    "start:test": "ng serve --configuration=test --port=8100",
    "start:prod": "ng serve --configuration=production --port=8100",
    "build": "ionic build",
    "build:test": "ng build --configuration=test",
    "build:prod": "ng build --configuration=production",
    "copy:test:android": "npm run build:test && npx cap copy android && node tools/manage-network-security.js test && npx cap open android",
    "copy:prod:android": "npm run build:prod && npx cap copy android && node tools/manage-network-security.js prod && npx cap open android",
    "copy:test:ios": "npm run build:test && npx cap copy ios",
    "copy:prod:ios": "npm run build:prod && npx cap copy ios",
    "sync": "ionic cap sync",
    "sync:test:android": "npm run build:test && npx cap sync android && node tools/manage-network-security.js test && npx cap open android",
    "sync:prod:android": "npm run build:prod && npx cap sync android && node tools/manage-network-security.js prod && npx cap open android",
    "open:android": "ionic cap open android",
    "open:ios": "ionic cap open ios",
    "run:android": "ionic cap run android -l --external --open",
    "run:ios": "ionic cap run ios -l --external --open",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "format:write": "prettier --write \"**/src/**/*.{ts,js,json,html,css,scss,md}\"",
    "format:check": "prettier --check \"**/src/**/*.{ts,js,json,html,css,scss,md}\""
  },
  "dependencies": {
    "@angular/animations": "^16.2.12",
    "@angular/cdk": "^16.2.12",
    "@angular/common": "^16.2.12",
    "@angular/core": "^16.2.12",
    "@angular/forms": "^16.2.12",
    "@angular/material": "^16.2.12",
    "@angular/material-moment-adapter": "^16.2.12",
    "@angular/platform-browser": "^16.2.12",
    "@angular/platform-browser-dynamic": "^16.2.12",
    "@angular/router": "^16.2.12",
    "@capacitor-community/barcode-scanner": "^4.0.1",
    "@capacitor/android": "5.7.8",
    "@capacitor/app": "^5.0.0",
    "@capacitor/app-launcher": "^5.0.0",
    "@capacitor/browser": "^5.2.1",
    "@capacitor/camera": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/device": "^5.0.0",
    "@capacitor/filesystem": "^5.0.0",
    "@capacitor/geolocation": "^5.0.0",
    "@capacitor/haptics": "^5.0.0",
    "@capacitor/ios": "5.7.8",
    "@capacitor/keyboard": "^5.0.0",
    "@capacitor/network": "^5.0.8",
    "@capacitor/preferences": "^5.0.7",
    "@capacitor/push-notifications": "^5.0.0",
    "@capacitor/splash-screen": "^5.0.0",
    "@capacitor/status-bar": "^5.0.0",
    "@capgo/capacitor-native-biometric": "^5.1.1",
    "@fortawesome/angular-fontawesome": "^0.13.0",
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@ionic/angular": "^7.8.6",
    "@ionic/angular-toolkit": "^12.3.0",
    "@ionic/core": "^7.8.6",
    "@ionic/storage-angular": "^4.0.0",
    "@zxing/library": "^0.21.3",
    "angular-eslint": "^19.0.2",
    "bootstrap": "^4.5.2",
    "crypto-js": "^4.2.0",
    "hammerjs": "^2.0.8",
    "jetifier": "^1.6.8",
    "moment": "^2.27.0",
    "rxjs": "^7.8.2",
    "shadow-dom-inject-styles": "^1.0.3",
    "signature_pad": "^5.0.4",
    "swiper": "^12.0.3",
    "tslib": "^2.6.2",
    "zone.js": "^0.13.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.12",
    "@angular-devkit/core": "^16.2.12",
    "@angular-devkit/schematics": "^16.2.12",
    "@angular/cli": "^16.2.16",
    "@angular/compiler": "^16.2.12",
    "@angular/compiler-cli": "^16.2.12",
    "@angular/language-service": "^16.2.12",
    "@capacitor/cli": "^5.0.0",
    "@types/jasmine": "~3.10.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~18.0.0",
    "@types/ws": "~8.5.0",
    "angular-eslint": "19.0.2",
    "eslint": "^9.16.0",
    "jasmine-core": "~3.10.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.7.0",
    "protractor": "^7.0.0",
    "typescript": "5.1",
    "typescript-eslint": "8.18.0"
  }
}
